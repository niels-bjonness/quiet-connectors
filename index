(function(){
  var views=["highlights","article"];
  var panels=document.querySelectorAll("[data-panel]");
  var buttons=document.querySelectorAll("nav.switch button");
  function show(id,scroll){
    if(views.indexOf(id)<0) id="highlights";
    panels.forEach(function(p){p.hidden=(p.id!==id);});
    buttons.forEach(function(b){b.setAttribute("aria-pressed",b.dataset.view===id?"true":"false");});
    if(scroll){var nav=document.querySelector("nav.switch");window.scrollTo({top:Math.max(0,nav.offsetTop-4),behavior:"auto"});}
  }
  function go(id){
    if(location.hash!=="#"+id){location.hash=id;} else {show(id,true);}
  }
  buttons.forEach(function(b){b.addEventListener("click",function(){go(b.dataset.view);});});
  document.querySelectorAll("[data-go]").forEach(function(b){b.addEventListener("click",function(){go(b.dataset.go);});});
  window.addEventListener("hashchange",function(){show(location.hash.slice(1),true);});
  show(location.hash.slice(1),false);
})();
</script>
